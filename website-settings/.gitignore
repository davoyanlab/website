# Nuxt
.nuxt/
.output/
# no trailing slash: `nuxt generate` leaves `dist` as a symlink to
# .output/public, and a `dist/` rule would not match a symlink
dist

# Node
node_modules/
# package-lock.json is intentionally COMMITTED — it pins the exact version of
# every dependency so Netlify builds the same site we tested locally.
# Do not add it here.

# Environment
.env
.env.*

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db

# TypeScript
*.tsbuildinfo

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# Scripts
scripts/

#Cache
.data/
